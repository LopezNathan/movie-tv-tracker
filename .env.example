# Choose cloudflare-access or tailnet-single-user.
AUTH_MODE=cloudflare-access

# Identity shown inside Scene when AUTH_MODE=tailnet-single-user.
APP_USER_EMAIL=you@example.com

# TMDB v4 API read-access token.
TMDB_API_TOKEN=replace-with-your-token

# Use a one-off, preferably pre-authorized Tailscale auth key for the first start.
# After Tailscale state is persisted, this may be left blank on later starts.
TS_AUTHKEY=tskey-auth-replace-me
TS_HOSTNAME=scene

# Optional, for example: --advertise-tags=tag:container
TS_EXTRA_ARGS=

# Cloudflare Tunnel + Access settings. The tunnel token is a secret.
CF_TUNNEL_TOKEN=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-aud-tag

# This hostname must be routed to the same Worker but excluded from Cloudflare Access.
MOBILE_API_HOST=api.scene.nathanlopez.com
